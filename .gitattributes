# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
*.cpp text
*.h text
*.c text
*.hpp text
*.cmake text
CMakeLists.txt text

# Shaders
*.vert text
*.frag text
*.geom text
*.glsl text

# Data files
*.json text
*.xml text
*.md text
*.txt text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.obj binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.so binary
*.a binary
*.lib binary
