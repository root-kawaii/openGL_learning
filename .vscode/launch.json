{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug OpenGL Project (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/hephaestus-openGL",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "moduleLoad": false,
                "trace": false
            }
        },
        {
            "name": "Debug OpenGL Project (LLDB - macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/your_executable_name",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "build"
        },
        {
            "name": "Debug OpenGL Project (MSVC - Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/your_executable_name.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        },
        {
            "name": "Debug with RenderDoc Integration",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/your_executable_name",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "RENDERDOC_HOOK_EGL",
                    "value": "0"
                },
                {
                    "name": "MESA_GL_VERSION_OVERRIDE",
                    "value": "4.5"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build"
        }
    ]
}