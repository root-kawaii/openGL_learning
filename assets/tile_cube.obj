# tile_cube.obj
# Unit cube with vertices at +/-1.0 (matches stone_cube.glb world scale).
# Every face has its own independent [0,1]x[0,1] UV — no atlas packing,
# so texTiling multiplies cleanly without stretching or seams.
# 24 vertices (4 per face, unshared).

# ── Positions ─────────────────────────────────────────────────────────────────
# Top (+Y)
v -1.0  1.0  1.0
v  1.0  1.0  1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
# Bottom (-Y)
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0 -1.0  1.0
v -1.0 -1.0  1.0
# Front (+Z)
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0
# Back (-Z)
v  1.0 -1.0 -1.0
v -1.0 -1.0 -1.0
v -1.0  1.0 -1.0
v  1.0  1.0 -1.0
# Left (-X)
v -1.0 -1.0 -1.0
v -1.0 -1.0  1.0
v -1.0  1.0  1.0
v -1.0  1.0 -1.0
# Right (+X)
v  1.0 -1.0  1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v  1.0  1.0  1.0

# ── UVs — full [0,1] range reused per face ────────────────────────────────────
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# ── Normals ───────────────────────────────────────────────────────────────────
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0

# ── Faces ─────────────────────────────────────────────────────────────────────
o Cube

# Top
f  1/1/1  2/2/1  3/3/1
f  1/1/1  3/3/1  4/4/1
# Bottom
f  5/1/2  6/2/2  7/3/2
f  5/1/2  7/3/2  8/4/2
# Front
f  9/1/3 10/2/3 11/3/3
f  9/1/3 11/3/3 12/4/3
# Back
f 13/1/4 14/2/4 15/3/4
f 13/1/4 15/3/4 16/4/4
# Left
f 17/1/5 18/2/5 19/3/5
f 17/1/5 19/3/5 20/4/5
# Right
f 21/1/6 22/2/6 23/3/6
f 21/1/6 23/3/6 24/4/6
